{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ztd-blog",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "blog.ztd.me", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client",
    "run_worker_first": true
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://blog.ztd.me",
    "NOTION_DATA_SOURCE_ID": "417c263c-c594-8099-a9f5-000be11373f6"
  },
  "kv_namespaces": [
    {
      "binding": "NOTION_CACHE",
      "id": "a27537e46cdd486f9c90257f3adec7a2"
    }
  ]
}
