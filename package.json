{
  "name": "@zeithrold/blog",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8800 --strictPort",
    "build": "vite build",
    "preview": "wrangler dev --local --config dist/server/wrangler.json --ip 127.0.0.1 --port 8800 --local-upstream 127.0.0.1:8800 --var PUBLIC_ORIGIN:http://127.0.0.1:8800",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:css": "ztd-css css-check.config.mjs",
    "test": "pnpm test:unit && pnpm test:dom",
    "test:unit": "node --import tsx --test --test-reporter=spec 'tests/unit/**/*.test.ts'",
    "test:dom": "vitest run",
    "test:browser": "playwright test",
    "test:integration": "node --import tsx --test --test-concurrency=1 --test-reporter=spec 'tests/integration/*.integration.ts'",
    "check": "pnpm lint && pnpm check:css && pnpm typecheck && pnpm test && pnpm build && pnpm test:integration && pnpm test:browser"
  },
  "dependencies": {
    "@notionhq/client": "5.31.1",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "get-nonce": "1.0.1",
    "i18next": "26.4.2",
    "katex": "0.18.4",
    "lucide-react": "1.49.0",
    "notion-types": "8.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "react-notion-x": "8.0.8",
    "react-server-dom-webpack": "19.3.0",
    "tailwind-merge": "3.7.0",
    "vaul": "1.1.2",
    "vinext": "1.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.2",
    "@cloudflare/workers-types": "5.20261002.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.0",
    "@vitejs/plugin-rsc": "0.5.35",
    "@ztd-me/eslint": "0.1.5",
    "@ztd-me/frontend-checks": "0.1.4",
    "eslint": "10.11.0",
    "jsdom": "30.1.3",
    "miniflare": "5.20260926.1-alpha",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.5",
    "wrangler": "4.144.0"
  }
}
