{
  "name": "@zeithrold/blog",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "pnpm db:local && vite --host 127.0.0.1 --port 8800 --strictPort",
    "build": "vite build",
    "preview": "wrangler dev --local --config dist/server/wrangler.json --port 8800",
    "db:local": "wrangler d1 migrations apply DB --local",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:css": "ztd-css css-check.config.mjs",
    "test:prepare": "node --import tsx tests/support/verification/prepare.ts",
    "test:unit": "BLOG_TEST_LAYER=unit node --import tsx --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./tests/support/verification/node-reporter.ts --test-reporter-destination=stdout 'tests/unit/*.test.ts'",
    "test:dom": "vitest run --config vitest.dom.config.ts",
    "test:ci-plan": "node --import tsx --test 'tests/ci/*.test.ts'",
    "test:integration": "BLOG_TEST_LAYER=integration node --import tsx --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./tests/support/verification/node-reporter.ts --test-reporter-destination=stdout 'tests/integration/*.integration.ts'",
    "test:components": "playwright test --config playwright.components.config.ts",
    "test:contracts": "node --import tsx tests/contracts/verify.ts",
    "test:e2e": "playwright test --project=chromium --project=webkit",
    "test:core": "playwright test tests/browser/editor/editor.spec.ts tests/browser/media/media.spec.ts tests/browser/journeys/lifecycle.spec.ts tests/browser/journeys/content.spec.ts tests/browser/journeys/publication.spec.ts tests/browser/journeys/recovery.spec.ts --project=chromium --project=webkit",
    "test:diagnose": "playwright test",
    "test:journeys": "playwright test tests/browser/journeys --project=chromium --project=webkit",
    "test:controls": "pnpm test:contracts",
    "test:development": "playwright test --config playwright.development.config.ts",
    "check:base": "pnpm test:prepare && pnpm lint && pnpm check:css && pnpm typecheck && pnpm test:unit && pnpm test:dom && pnpm test:ci-plan && pnpm build && pnpm test:integration",
    "check": "pnpm check:base && pnpm test:components && pnpm test:e2e && pnpm test:editor-performance && pnpm test:development && pnpm test:contracts",
    "test:a11y": "playwright test --project=chromium --project=webkit --grep \"accessibility scanner\"",
    "test:editor-performance": "BLOG_TEST_ARTIFACT_SCOPE=performance playwright test --project=performance"
  },
  "dependencies": {
    "@blocknote/core": "0.55.0",
    "@blocknote/react": "0.55.0",
    "@floating-ui/react": "0.27.20",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tiptap/core": "3.31.4",
    "dompurify": "3.4.16",
    "fast-xml-parser": "5.3.8",
    "get-nonce": "1.0.1",
    "i18next": "26.4.2",
    "jose": "6.2.12",
    "katex": "0.19.0",
    "lucide-react": "1.49.0",
    "mermaid": "12.1.0",
    "prosemirror-history": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "react": "19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "react-server-dom-webpack": "19.3.0",
    "shiki": "4.5.0",
    "tailwind-merge": "3.7.0",
    "vaul": "1.1.2",
    "vinext": "1.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.2",
    "@cloudflare/workers-types": "5.20261002.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.0",
    "@vitejs/plugin-rsc": "0.5.35",
    "@ztd-me/eslint": "0.1.5",
    "@ztd-me/frontend-checks": "0.1.4",
    "eslint": "10.11.0",
    "jsdom": "30.1.3",
    "miniflare": "5.20260926.1-alpha",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.5",
    "wrangler": "4.144.0"
  }
}
